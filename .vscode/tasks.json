{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build and Upload",
      "type": "shell",
      "command": "~/.platformio/penv/bin/pio",
      "args": [
        "run",
        "-t",
        "upload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}